{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Newsletter Schema",
  "description": "Schema for SAPA PHILATEX newsletter metadata",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the newsletter: YYYY-QN for quarterly issues, YYYY-MM (first month of the issue) for bimonthly issues",
      "pattern": "^[0-9]{4}-(Q[1-4]|0[1-9]|1[0-2])$"
    },
    "title": {
      "type": "string",
      "description": "Full title of the newsletter",
      "examples": ["SAPA PHILATEX Third Quarter 2025"]
    },
    "quarter": {
      "type": "string",
      "enum": ["First", "Second", "Third", "Fourth"],
      "description": "Quarter of publication (quarterly issues)"
    },
    "months": {
      "type": "array",
      "description": "Months covered, in order (bimonthly issues), e.g. [\"January\", \"February\"]",
      "items": {
        "type": "string",
        "enum": ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "year": {
      "type": "integer",
      "minimum": 1954,
      "maximum": 2099,
      "description": "Year of publication"
    },
    "publishDate": {
      "type": "string",
      "format": "date",
      "description": "Publication date in YYYY-MM-DD format"
    },
    "filePath": {
      "type": "string",
      "description": "Relative path to the PDF file",
      "pattern": "^public/.*\\.pdf$"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the newsletter content"
    },
    "featuredArticles": {
      "type": "array",
      "description": "Array of featured articles in this issue",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Article title"
          },
          "author": {
            "type": "string",
            "description": "Article author"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Page number where article starts"
          },
          "category": {
            "type": "string",
            "enum": ["Calendar", "Collection Tips", "Education", "Feature", "History", "Humor", "Meeting Report", "Member Spotlight", "News", "Show Report"],
            "description": "Article category"
          }
        },
        "required": ["title", "category"]
      }
    },
    "highlights": {
      "type": "array",
      "description": "Key highlights or topics covered",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "description": "Tags for categorization and search",
      "items": {
        "type": "string"
      }
    },
    "pageCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Total number of pages"
    },
    "fileSize": {
      "type": "string",
      "description": "File size (e.g., '2.1 MB')"
    },
    "status": {
      "type": "string",
      "enum": ["published", "archived", "draft"],
      "default": "published",
      "description": "Publication status"
    }
  },
  "required": ["id", "title", "year", "publishDate", "filePath", "description"],
  "if": {
    "properties": { "id": { "type": "string", "pattern": "^[0-9]{4}-Q[1-4]$" } }
  },
  "then": { "required": ["quarter"] },
  "else": { "required": ["months"] },
  "additionalProperties": false
}