{
  "name": "sastamps",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "npm run build && npm run serve",
    "serve": "node -e \"require('fs').existsSync('_site')||(console.error('_site/ is missing: run npm run build first'),process.exit(1))\" && http-server _site -p 3000",
    "build": "node scripts/build.js",
    "build:css": "node scripts/build-css.js",
    "build:js": "node esbuild.config.js",
    "build:js:legacy": "esbuild js/script.js --bundle --minify --outfile=dist/js/script.min.js",
    "analyze:bundle": "node esbuild.config.js && cat dist/bundle-analysis.json",
    "download:newsletters": "node scripts/download-newsletters.mjs",
    "analyze": "node scripts/analyze-image-savings.js",
    "monitor": "npm run serve",
    "build:search": "node scripts/build-search-index.js",
    "build:search:embed": "node scripts/build-search-embedded.js _site/search.html",
    "test": "npm run test:html && npm run test:inline-js && npm run test:links && npm run test:js && npm run test:css && npm run test:md",
    "test:html": "html-validate '*.html' '!test-*.html' --config .htmlvalidate.json",
    "test:links": "echo 'Run npm run test:links:server in a separate terminal first' && linkinator http://localhost:3000 --recurse --skip 'external'",
    "test:links:server": "echo 'Starting server for link checking...' && npm run serve",
    "test:js": "eslint js/**/*.js js/font-loading.js",
    "test:inline-js": "node scripts/check-inline-scripts.js",
    "test:inline-js:site": "node scripts/check-inline-scripts.js _site",
    "test:css": "stylelint 'css/**/*.css' --config .stylelintrc.json",
    "test:md": "markdownlint '**/*.md' --ignore node_modules --ignore browser-tools-test --ignore 'dist/**' --ignore '_site/**' --ignore '*.bak' --ignore 'graphify-out/**' --config .markdownlintrc.json",
    "test:a11y": "pa11y-ci --config .pa11yrc.json",
    "audit": "npm run audit:lighthouse && npm run audit:security",
    "audit:lighthouse": "lighthouse http://localhost:3000 --output html --output-path ./reports/lighthouse.html --view",
    "audit:security": "npm audit",
    "test:font-loading": "node scripts/test-font-loading.js",
    "test:quick": "npm run test:html && npm run test:inline-js && npm run test:js && npm run test:css",
    "validate:data": "node scripts/validate-data.js",
    "pretest": "mkdir -p reports",
    "test:site-build": "node scripts/check-site-build.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arlenagreer/arlenagreer.github.io.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/arlenagreer/arlenagreer.github.io/issues"
  },
  "homepage": "https://github.com/arlenagreer/arlenagreer.github.io#readme",
  "description": "",
  "dependencies": {
    "@types/node": "^26.6.3",
    "lunr": "^2.3.9",
    "node-fetch": "^3.3.2",
    "sharp": "^0.35.5",
    "vanilla-calendar-pro": "^3.4.0",
    "yargs": "^17.7.3"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "html-validate": "^11.16.1",
    "http-server": "^14.1.1",
    "lighthouse": "^13.5.0",
    "linkinator": "^7.6.1",
    "markdownlint-cli": "^0.49.1",
    "pa11y": "^10.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  },
  "overrides": {
    "glob": "^11.1.0",
    "markdownlint-cli": {
      "js-yaml": "^5.4.1"
    }
  }
}
